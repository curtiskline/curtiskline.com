# R2 credentials for scripts/ingest.mjs (local ingest only — never used in CI/build).
# Copy to .env (gitignored) and fill in. Create an R2 API token in the Cloudflare
# dashboard: R2 > Manage R2 API Tokens > Create (Object Read & Write).

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=curtiskline-photos
