---
import { getCollection } from 'astro:content';
import GalleryLayout from '../../layouts/GalleryLayout.astro';
import { sortByDateDesc } from '../../lib/gallery';

const photos = sortByDateDesc(await getCollection('photos'));
---

<GalleryLayout
  title="Photos — curtiskline.com"
  description="Photography by Curtis Kline — Burning Man, camping, travel, and more."
  heading="Photos"
  photos={photos}
  activeSection={null}
/>
