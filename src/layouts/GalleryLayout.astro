---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FilterBar from '../components/FilterBar.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import type { Photo } from '../lib/gallery';

interface Props {
  title: string;
  description?: string;
  heading: string;
  photos: Photo[];
  /** Section slug for the active nav item, or null on the "all"/tag views. */
  activeSection?: string | null;
}

const { title, description, heading, photos, activeSection = null } = Astro.props;

// Nav lists only sections that actually have photos.
const [allPhotos, sections] = await Promise.all([getCollection('photos'), getCollection('sections')]);
const withPhotos = sections
  .filter((s) => allPhotos.some((p) => p.data.section === s.id))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={title} description={description}>
  <section id="gallery">
    <div class="container">
      <header class="major gallery-head">
        <h1>{heading}</h1>
      </header>

      <nav class="gallery-nav" aria-label="Photo sections">
        <a href="/" class="gallery-home">← Home</a>
        <span class="gallery-nav-sep" aria-hidden="true">|</span>
        <a href="/gallery/" class:list={['gallery-nav-link', { active: activeSection === null }]}>All</a>
        {
          withPhotos.map((s) => (
            <a
              href={`/gallery/${s.id}/`}
              class:list={['gallery-nav-link', { active: activeSection === s.id }]}
            >
              {s.data.title}
            </a>
          ))
        }
      </nav>

      {
        photos.length ? (
          <>
            <FilterBar photos={photos} />
            <PhotoGrid photos={photos} />
            <p class="filter-empty" hidden>
              No photos match those filters.{' '}
              <button type="button" class="filter-empty-clear">
                Clear filters
              </button>
            </p>
          </>
        ) : (
          <p class="gallery-empty">No photos yet — check back soon.</p>
        )
      }
    </div>
  </section>

  <script>
    // Route-scoped: PhotoSwipe + filtering only load on gallery pages.
    import '../scripts/lightbox.ts';
    import '../scripts/filter.ts';
  </script>
</BaseLayout>

<style is:global>
  #gallery {
    position: relative;
    min-height: 100vh;
    padding: 5em 0;
  }

  #gallery > .container {
    background: rgba(255, 255, 255, 0.96);
    box-shadow: inset 0 1px 0 0 #dddddd;
    padding: 3.5em 2.5em;
  }

  .gallery-head {
    text-align: center;
  }

  .gallery-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.4em 1.1em;
    margin: 0 0 2em;
  }

  .gallery-nav a {
    border-bottom: none;
    color: #6f7577;
    font-size: 0.8em;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .gallery-nav .gallery-nav-link.active {
    color: #8cd1a8;
  }

  .gallery-nav .gallery-nav-sep {
    color: #dddddd;
  }

  /* Filter bar */
  .filter-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1em;
    margin: 0 0 2.5em;
    padding-bottom: 2em;
    border-bottom: solid 1px #dddddd;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5em;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.35em 0.9em;
    border: solid 1px #dddddd;
    border-radius: 2em;
    background: transparent;
    color: #6f7577;
    cursor: pointer;
    font-size: 0.75em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .filter-chip:hover {
    border-color: #8cd1a8;
    color: #61686b;
  }

  .filter-chip[aria-pressed='true'] {
    background: #8cd1a8;
    border-color: #8cd1a8;
    color: #ffffff;
  }

  .filter-chip .chip-count {
    font-size: 0.85em;
    opacity: 0.65;
  }

  .filter-meta {
    display: flex;
    align-items: center;
    gap: 1.25em;
  }

  .filter-status {
    margin: 0;
    color: #a8b0b3;
    font-size: 0.75em;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .filter-clear {
    border: 0;
    background: none;
    color: #8cd1a8;
    cursor: pointer;
    font-size: 0.75em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0;
  }

  .filter-empty,
  .gallery-empty {
    text-align: center;
    color: #a8b0b3;
    padding: 3em 0;
  }

  .filter-empty-clear {
    border: 0;
    background: none;
    color: #8cd1a8;
    cursor: pointer;
    font: inherit;
    text-decoration: underline;
    padding: 0;
  }

  /* Grid */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    grid-auto-flow: dense;
    gap: 12px;
  }

  .photo-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-bottom: none;
    background-color: var(--photo-color, #e8f0f3);
    cursor: zoom-in;
  }

  .photo-card.is-hidden {
    display: none;
  }

  .photo-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .photo-card img.is-loaded {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-card img {
      transition: none;
    }
  }

  /* PhotoSwipe caption + clickable tags */
  .pswp-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1em 1.25em calc(1em + env(safe-area-inset-bottom));
    text-align: center;
    pointer-events: none;
  }
  .pswp-caption .cap-text {
    display: block;
    max-width: 46em;
    margin: 0 auto 0.4em;
    color: #fff;
    font-size: 0.85em;
    line-height: 1.5;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }
  .pswp-caption .cap-tags {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75em;
  }
  .pswp-caption .cap-tags a {
    pointer-events: auto;
    color: #8cd1a8;
    border-bottom: none;
    font-size: 0.75em;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 480px) {
    #gallery > .container {
      padding: 2.5em 1.25em;
    }
    .photo-grid {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 8px;
    }
  }
</style>
