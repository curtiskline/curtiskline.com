---
import '../styles/main.scss';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'curtiskline.com',
  description = 'Curtis Kline — technology, entrepreneurship, and business.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en" class="is-preload">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Fonts (swap so text paints immediately) + image CDN preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://img.curtiskline.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,400;0,700;0,800;1,400&display=swap"
    />

    <!-- Icons / PWA -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#313a3d" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.jpg', Astro.site).href} />
  </head>
  <body>
    <main>
      <slot />
    </main>

    <script>
      // Replaces jquery.scrollex / jquery.scrolly / main.js — no jQuery.
      const html = document.documentElement;

      // Play initial animations once loaded (mirrors the is-preload removal).
      window.addEventListener('load', () => {
        window.setTimeout(() => html.classList.remove('is-preload'), 100);
      });

      // Per-section fixed backgrounds: fade in the bg whose section is at the
      // viewport's vertical center (mirrors scrollex `mode: 'middle'`).
      const sections = document.querySelectorAll<HTMLElement>('.main[data-bg]');
      if (sections.length) {
        const bgObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const id = entry.target.getAttribute('data-bg');
              const bg = id && document.getElementById(id);
              if (bg) bg.classList.toggle('active', entry.isIntersecting);
            }
          },
          { rootMargin: '-50% 0px -50% 0px', threshold: 0 }
        );
        sections.forEach((s) => bgObserver.observe(s));
      }

      // Fade the fixed header title out as the header scrolls away
      // (mirrors the scrollex progress handler, desktop only).
      const headerTitle = document.querySelector<HTMLElement>('#header > header');
      const header = document.getElementById('header');
      if (headerTitle && header) {
        const mq = window.matchMedia('(min-width: 737px)');
        const onScroll = () => {
          if (!mq.matches) {
            headerTitle.style.opacity = '';
            return;
          }
          // Fully visible at the top, fading to 0 as the header scrolls away.
          const opacity = 1 - window.scrollY / header.offsetHeight;
          headerTitle.style.opacity = String(Math.max(0, Math.min(1, opacity)));
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        mq.addEventListener('change', onScroll);
        onScroll();
      }
    </script>
  </body>
</html>
